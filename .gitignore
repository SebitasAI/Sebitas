# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Secrets / env: NEVER commit. Doppler injects these at runtime via `doppler run`.
.env
.env.*
*.local

# Claude Code local settings (machine-specific; can embed local command args). Not shared.
.claude/settings.local.json

# uv: the lockfile (uv.lock) IS committed; do not ignore it.

# OS
.DS_Store
spaces-template/.env.local

# spaces-template build / install / runtime artifacts. node_modules is 369 MB;
# dist/ is the Vite output (regenerated on build); .wrangler/ is local CF state;
# convex/_generated/ is regenerated on `convex dev` / `convex deploy`.
spaces-template/node_modules/
spaces-template/dist/
spaces-template/.wrangler/
spaces-template/convex/_generated/
